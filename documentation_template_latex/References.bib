@article{WANDERLINGH202447,
title = {Model Based Navigation for a Twin Thruster Autonomous Surface Catamaran},
journal = {IFAC-PapersOnLine},
volume = {58},
number = {20},
pages = {47-52},
year = {2024},
note = {15th IFAC Conference on Control Applications in Marine Systems, Robotics and Vehicles CAMS 2024},
issn = {2405-8963},
doi = {https://doi.org/10.1016/j.ifacol.2024.10.031},
url = {https://www.sciencedirect.com/science/article/pii/S2405896324017853},
author = {Francesco Wanderlingh and Enrico Simetti and Giovanni Indiveri},
keywords = {Navigation of autonomous surface vehicles, Sensor integration in autonomous robots, Architectures for autonomous vehicles, System identification for marine systems},
abstract = {The paper describes the design, implementation, and performance assessment of a navigation system for a small-size robotic twin thruster autonomous surface vessel (ASV). The navigation solution is designed building on a first principles maneuvering model that includes sources of nonlinearity and asymmetry of this class of catamaran robots. The paper illustrates how the proposed model is exploited in the navigation filter design and implementation and it discusses its impact on the overall navigation performance. Experimental results relative to the ULISSE ASV are included and illustrated.}
}

